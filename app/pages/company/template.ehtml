import "./style.css";
import { LiveView, redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { Me } from "#app/shared/services/auth";
import { Company } from "#app/shared/services/companies";
import { Contact } from "#app/shared/services/contacts";
import { Deal } from "#app/shared/services/deals";
import { STAGES, STAGE_LABELS, formatMoney, formatCompactMoney, formatDay, initials, isOpen } from "#app/shared/services/format";
import favicon from "#app/shared/assets/favicons/favicon.svg";

export interface CompanyEdit {
  name: string;
  domain: string;
  industry: string;
  saved: boolean;
  error: string;
}

export function editFor(c: Company): CompanyEdit {
  return { name: c.name, domain: c.domain, industry: c.industry, saved: false, error: "" };
}

function byStage(a: Deal, b: Deal): number {
  return STAGES.indexOf(a.stage) - STAGES.indexOf(b.stage) || b.value - a.value;
}

function openValue(deals: LiveView<Deal>): number {
  return deals.filter((d) => isOpen(d.stage)).reduce((s, d) => s + d.value, 0);
}

function wonValue(deals: LiveView<Deal>): number {
  return deals.filter((d) => d.stage === "won").reduce((s, d) => s + d.value, 0);
}

function site(domain: string): string {
  return /^https?:\/\//.test(domain) ? domain : `https://${domain}`;
}

function onSave(edit: CompanyEdit, companies: LiveView<Company>, c: Company) {
  try {
    companies.update({ ...c, name: edit.name.trim(), domain: edit.domain.trim(), industry: edit.industry.trim() });
    edit.error = "";
    edit.saved = true;
  } catch (err: any) {
    edit.error = err.message;
    edit.saved = false;
  }
}

function onDelete(companies: LiveView<Company>, c: Company) {
  if (!confirm(`Delete ${c.name}? Its contacts and deals stay, without a company.`)) {
    return;
  }

  companies.delete(c);
  redirect("/companies");
}

<html lang="en" class="page-company" (
  me: Me,
  companyId: string,
  companies: LiveView<Company>,
  contacts: LiveView<Contact>,
  deals: LiveView<Deal>,
  edit: CompanyEdit,
)>
  <head>
    <title>{companies.get(companyId)?.name ?? "Company"} · dealwren</title>
    <meta name="description" content="A company's contacts and deals.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {me} active="companies">
      <nav class="crumb row">
        <a href="/companies">Companies</a>
        <span>/</span>
        <span>Company</span>
      </nav>

      <div e:if={!companies.get(companyId)} class="gone stack">
        <h1>This company was deleted</h1>
        <p><a class="button" href="/companies">Back to companies</a></p>
      </div>

      <CompanyView e:else {me} c={companies.get(companyId)!} {companies} {contacts} {deals} {edit} />
    </Layout>
  </body>
</html>

<CompanyView (
  me: Me,
  c: Company,
  companies: LiveView<Company>,
  contacts: LiveView<Contact>,
  deals: LiveView<Deal>,
  edit: CompanyEdit,
)>
  <header class="co-head">
    <div class="co-title row">
      <span class="co-mark">{initials(c.name)}</span>
      <div class="stack is-xs">
        <h1>{c.name}</h1>
        <div class="co-sub cluster">
          <span e:if={c.industry}>{c.industry}</span>
          <a e:if={c.domain} href={site(c.domain)} target="_blank" rel="noopener">{c.domain}</a>
        </div>
      </div>
    </div>
    <div class="co-stats row">
      <span class="co-stat"><strong>{formatCompactMoney(openValue(deals))}</strong><span>open pipeline</span></span>
      <span class="co-stat"><strong>{formatCompactMoney(wonValue(deals))}</strong><span>won</span></span>
    </div>
  </header>

  <div class="co-grid">
    <section class="card list-card">
      <div class="card-head">
        <h2>Deals <span class="muted">{deals.length}</span></h2>
        <a class="button is-sm" href={"/pipeline?new=1&company=" + c.id}>New deal</a>
      </div>
      <table e:if={deals.length > 0} class="list-table">
        <tbody>
          <tr e:for={d of deals.sort(byStage)} class={"stage-" + d.stage}>
            <td>
              <a class="list-name" href={"/deals/" + d.id}>{d.name}</a>
              <span class="list-sub">{d.ownerName ?? "Unassigned"}<span e:if={d.closeOn}> · closes {formatDay(d.closeOn)}</span></span>
            </td>
            <td><span class="stage-tag"><span class="stage-dot"></span>{STAGE_LABELS[d.stage]}</span></td>
            <td class="num money">{formatMoney(d.value)}</td>
          </tr>
        </tbody>
      </table>
      <p e:else class="empty-note">No deals yet.</p>
    </section>

    <section class="card list-card">
      <div class="card-head">
        <h2>Contacts <span class="muted">{contacts.length}</span></h2>
        <a class="button is-sm" href={"/contacts?new=1&company=" + c.id}>New contact</a>
      </div>
      <table e:if={contacts.length > 0} class="list-table">
        <tbody>
          <tr e:for={p of contacts.sort((a, b) => a.name.localeCompare(b.name))}>
            <td>
              <a class="list-name" href={"/contacts/" + p.id}><span class="avatar is-sm">{initials(p.name)}</span>{p.name}</a>
            </td>
            <td class="list-sub"><a e:if={p.email} href={"mailto:" + p.email}>{p.email}</a></td>
            <td class="list-sub is-wide-only">{p.phone}</td>
          </tr>
        </tbody>
      </table>
      <p e:else class="empty-note">No contacts yet.</p>
    </section>

    <section class="card">
      <div class="card-head">
        <h2>Details</h2>
      </div>
      <div class="card-body">
        <form class="is-grid co-edit" onsubmit={() => onSave(edit, companies, c)} oninput={() => edit.saved = false}>
          <p e:if={edit.error} class="callout is-danger is-full" role="alert">{edit.error}</p>

          <div class="field is-full">
            <label for="co-name">Name</label>
            <input id="co-name" value={edit.name} required>
          </div>

          <div class="field">
            <label for="co-domain">Website</label>
            <input id="co-domain" value={edit.domain}>
          </div>

          <div class="field">
            <label for="co-industry">Industry</label>
            <input id="co-industry" value={edit.industry}>
          </div>

          <div class="co-edit-actions row">
            <button e:if={me.role === "owner"} type="button" class="is-ghost co-delete" onclick={() => onDelete(companies, c)}>Delete company</button>
            <span e:else></span>
            <span class="row" style={{ gap: "0.75rem" }}>
              <span e:if={edit.saved} class="text-success text-sm">Saved</span>
              <button type="submit" class="is-primary">Save</button>
            </span>
          </div>
        </form>
      </div>
    </section>
  </div>
</CompanyView>
